# Proxy API requests to the Cloudflare Worker backend
# Replace "nigord-backend.YOUR_SUBDOMAIN.workers.dev" with your actual deployed Worker URL!

/auth/* https://nigord-backend.sabinsubediofficial.workers.dev/auth/:splat 200
/users/* https://nigord-backend.sabinsubediofficial.workers.dev/users/:splat 200
/channels/* https://nigord-backend.sabinsubediofficial.workers.dev/channels/:splat 200
/signaling/* https://nigord-backend.sabinsubediofficial.workers.dev/signaling/:splat 200
/files/* https://nigord-backend.sabinsubediofficial.workers.dev/files/:splat 200
/dms/* https://nigord-backend.sabinsubediofficial.workers.dev/dms/:splat 200
